(ns {{base/ns}}.core-test
  (:require [clojure.data.json :as json]
            [clojure.string :as str]
            [ring.mock.request :as mock]
            [{{test-runner/namespace}} :as t]
            [{{base/ns}}.core :as sut]))

(t/{{test-runner/deftest}} index-test
  (t/{{test-runner/testing}} "GET / returns greeting"
    (let [resp (sut/app (mock/request :get "/"))]
      (t/{{test-runner/is}} (= 200 (:status resp)))
      (t/{{test-runner/is}} (str/includes? (:body resp) "Hello, World!"))))
  (t/{{test-runner/testing}} "GET /?name=Clojure greets by name"
    (let [resp (sut/app (mock/request :get "/?name=Clojure"))]
      (t/{{test-runner/is}} (= 200 (:status resp)))
      (t/{{test-runner/is}}
       (str/includes? (:body resp) "Hello, Clojure!")))))

(t/{{test-runner/deftest}} health-test
  (t/{{test-runner/testing}} "GET /health returns ok JSON"
    (let [resp (sut/app (mock/request :get "/health"))
          body (json/read-str (:body resp) {:key-fn keyword})]
      (t/{{test-runner/is}} (= 200 (:status resp)))
      (t/{{test-runner/is}} (= {:status "ok"} body)))))

(t/{{test-runner/deftest}} not-found-test
  (t/{{test-runner/testing}} "GET /missing returns 404"
    (let [resp (sut/app (mock/request :get "/missing"))]
      (t/{{test-runner/is}} (= 404 (:status resp))))))
