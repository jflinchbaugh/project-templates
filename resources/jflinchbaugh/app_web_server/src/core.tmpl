(ns {{base/ns}}.core
  (:require
   [clojure.string :as str]
   [taoensso.telemere :as tel]
   [tick.core :as t]
   [clojure.java.io :as io]
   [clojure.data.csv :as csv]
   [clojure.data.json :as json]
   [clojure.data.xml :as xml]
   [clj-yaml.core :as yaml]
   [org.httpkit.client :as http]
   [org.httpkit.server :as server]
   [reitit.ring :as ring]
   [ring.middleware.keyword-params :refer [wrap-keyword-params]]
   [ring.middleware.params :refer [wrap-params]]
   [ring.util.response :as resp]
   [hiccup.form :as f]
   [hiccup2.core :as h])
  (:gen-class))

(defonce ^:private server (atom nil))

(defn index-handler
  "Render the home page."
  [req]
  (let [who (or (get-in req [:params :name]) "World")
        body (str (h/html
                   [:html
                    [:head [:title "{{raw-name}}"]]
                    [:body [:h1 (str "Hello, " who "!")]]]))]
    (-> (resp/response body)
        (resp/content-type "text/html; charset=utf-8"))))

(defn health-handler
  "Return JSON health status."
  [_req]
  (-> (json/write-str {:status "ok"})
      (resp/response)
      (resp/content-type "application/json; charset=utf-8")))

(def routes
  [["/" {:get {:handler index-handler}}]
   ["/health" {:get {:handler health-handler}}]])

(defn make-app
  "Create the Ring handler for the web application."
  []
  (ring/ring-handler
   (ring/router routes)
   (ring/create-default-handler)
   {:middleware [wrap-params wrap-keyword-params]}))

(def app (make-app))

(defn stop
  "Stop the running HTTP server if one is active."
  []
  (when-let [stop-fn @server]
    (stop-fn :timeout 100)
    (reset! server nil)
    (tel/log! :info "Server stopped")))

(defn start
  "Start the HTTP server on the configured port."
  [{:keys [port] :or {port 8080}}]
  (stop)
  (let [stop-fn (server/run-server
                 (fn [req] (app req))
                 {:port port})]
    (reset! server stop-fn)
    (tel/log! :info (str "Server listening on port " port))))

(defn -main
  "Application entry point."
  [& args]
  (let [port (or (some-> (first args) parse-long)
                 (some-> (System/getenv "PORT") parse-long)
                 8080)]
    (start {:port port})))

(comment
  (start {:port 8080})

  @(http/get "http://localhost:8080/" {})

  @(http/get "http://localhost:8080/health" {})

  (stop)

  (json/read-str "{\"key\": \"value\"}" {:key-fn keyword})

  (str (h/html [:tag]))
  )
