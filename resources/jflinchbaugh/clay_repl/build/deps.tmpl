{:paths ["src" "notebooks" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        org.scicloj/noj {:mvn/version "2-beta24"}
        org.scicloj/clay {:mvn/version "2.0.24"}
        org.scicloj/kindly {:mvn/version "4-beta25"}
        org.clojure/math.combinatorics {:mvn/version "0.3.2"}
        org.clojure/data.priority-map {:mvn/version "1.2.1"}
        org.clojure/data.csv {:mvn/version "1.1.1"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        tick/tick {:mvn/version "1.0.3"}
        com.taoensso/telemere {:mvn/version "1.4.0"}
        com.taoensso/telemere-slf4j {:mvn/version "1.4.0"}
        org.slf4j/slf4j-api {:mvn/version "2.0.20"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        hiccup/hiccup {:mvn/version "2.0.0"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]}
  :nrepl {:extra-paths ["dev" "test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.64.1"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware"
                      "[cider.nrepl/cider-middleware]"]}
  :clay {:ns-default scicloj.clay.v2.api
         :exec-fn make!}
  :clay/watch {:main-opts ["-m" "scicloj.clay.v2.main"]}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      {{test-runner/coordinate}}}}}}
