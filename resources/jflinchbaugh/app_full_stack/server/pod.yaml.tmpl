apiVersion: v1
kind: Pod
metadata:
  name: {{artifact/id}}-server
spec:
  restartPolicy: on-failure
  containers:
    - name: api
      image: localhost/{{artifact/id}}-server:latest
      ports:
        - containerPort: 6000
          hostIp: 127.0.0.1
          hostPort: 6000
      env:
        - name: port
          value: "6000"
        - name: DATAHIKE_PATH
          value: "/var/lib/datahike/{{artifact/id}}.sqlite"
      volumeMounts:
        - mountPath: /var/lib/datahike
          name: datahike-data
  volumes:
    - name: datahike-data
      persistentVolumeClaim:
        claimName: {{artifact/id}}-datahike-data
