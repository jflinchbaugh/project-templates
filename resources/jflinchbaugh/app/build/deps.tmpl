{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.taoensso/telemere {:mvn/version "1.2.1"}
        tick/tick {:mvn/version "1.0"}
        org.clojure/data.csv {:mvn/version "1.1.1"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/data.xml {:mvn/version "0.0.8"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        hiccup/hiccup {:mvn/version "2.0.0"}}

 :aliases
 {:run-m {:main-opts ["-m" "{{top/ns}}.{{main/ns}}"]}
  :run-x {:ns-default {{top/ns}}.{{main/ns}}
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.12"}}
          :ns-default build}
  :dev {:extra-paths ["test"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      {{test-runner/coordinate}}}}}}
